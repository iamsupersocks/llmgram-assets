[Unit]
Description=LLMgram assets daily link check
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
WorkingDirectory=%h/llmgram-assets-mcp/app
# Own clone, never the gateway's working tree.
ExecStart=%h/llmgram-assets-mcp/app/.venv/bin/python -m llmgram_assets.recheck --git-checkout %h/llmgram-assets-mcp/recheck-data --ssh-key %h/.config/llmgram-assets-mcp/deploy_key
NoNewPrivileges=yes
PrivateTmp=yes
